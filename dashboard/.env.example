# 前端端口
VITE_PORT=3000

# API 基址。直连远端域名时若后端未配 CORS，浏览器会拦截请求。
# 方式 A — 后端已允许你的 dev 源（如 http://localhost:3000）：
# VITE_API_URL=https://your-api.example.com
# 方式 B — 本地开发走 Vite 代理（同源，无 CORS）：API 置空 + 下面一行填真实后端 origin
VITE_API_URL=https://your-api.example.com
VITE_DEV_PROXY_TARGET=https://your-api.example.com
