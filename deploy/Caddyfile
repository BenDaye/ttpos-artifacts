# 本项目贡献给主机 Caddy 的【站点片段】，不是完整 Caddyfile（边界详见 docs/plan/PLAN-037.md）。
# 只含本项目自己的站点块；全局配置、别的项目、Caddy 本体与网络都归主机 infra，勿写进这里。
# apps/server/server/caddy_config_test.go 对本文件做路由断言，勿随意改路由。
# /dl 短链不在这里：映射是每个 app 的 short_link 字段，由 API 解析（ENH-020/PLAN-043）。
#
# 用法：deploy/scripts/migrate-caddy-shortlinks.sh 把本片段 splice 进主机自有 Caddyfile
#   （如 vm-node02 /opt/caddy/Caddyfile）后 reload；prod 形态由该脚本带参派生，不另存第二份。
# 前置条件：faynosync-api / faynosync-dashboard 已加入外部 caddy-net 网络。

releases.ttpos.dev {
	reverse_proxy faynosync-dashboard:3000
}

update.ttpos.dev {
	# 放宽请求体上限以支持 >200MB 制品上传
	request_body {
		max_size 1GB
	}

	# /dl 公开短链已回归 API：映射由每个 app 的 short_link 字段决定（ENH-020/PLAN-043），
	# 缓存头也由 API 按状态码打。这里不再有短链表，新增 app 不需要动本文件。
	route {
		# MCP server（Streamable HTTP）挂在 /mcp 路径下，复用 API 域名、不另起子域名。
		# handle 保留路径，容器收到 /mcp；flush_interval -1 适配 SSE 流式响应。
		handle /mcp* {
			reverse_proxy faynosync-mcp:3010 {
				flush_interval -1
			}
		}

		# 其余路径（含 /dl）反代到 FaynoSync API。
		handle {
			reverse_proxy faynosync-api:9000
		}
	}
}
