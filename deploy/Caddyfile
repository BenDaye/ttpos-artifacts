# 本项目贡献给主机 Caddy 的【站点片段】，不是完整 Caddyfile（边界详见 docs/plan/PLAN-037.md）。
# 只含本项目自己的站点块；全局配置、别的项目、Caddy 本体与网络都归主机 infra，勿写进这里。
# 本文件是 /dl 短链契约的单一事实来源，apps/server/server/caddy_config_test.go 对它做断言，勿随意改路由。
#
# 用法：deploy/scripts/migrate-caddy-shortlinks.sh 把本片段 splice 进主机自有 Caddyfile
#   （如 vm-node02 /opt/caddy/Caddyfile）后 reload；prod 形态由该脚本带参派生，不另存第二份。
# 前置条件：faynosync-api / faynosync-dashboard 已加入外部 caddy-net 网络。

releases.ttpos.dev {
	reverse_proxy faynosync-dashboard:3000
}

update.ttpos.dev {
	# 放宽请求体上限以支持 >200MB 制品上传
	request_body {
		max_size 1GB
	}

	# /dl 公开短链入口由 Caddy 承载；/apps/latest 仍是 latest artifact 的事实查询源。
	map {path} {short_latest_app} {short_latest_platform} {short_latest_arch} {short_latest_package} {
		~(?i)^/dl/cashier\.apk$ ttpos android arm64 apk
		~(?i)^/dl/cashier\.exe$ ttpos windows amd64 exe
		~(?i)^/dl/cashier\.dmg$ ttpos macos arm64 dmg
		~(?i)^/dl/assistant\.apk$ ttpos_go android arm64 apk
		~(?i)^/dl/assistant\.exe$ ttpos_go windows amd64 exe
		~(?i)^/dl/assistant\.dmg$ ttpos_go macos arm64 dmg
		~(?i)^/dl/menu\.apk$ ttpos_menu android arm64 apk
		~(?i)^/dl/menu\.exe$ ttpos_menu windows amd64 exe
		~(?i)^/dl/menu\.dmg$ ttpos_menu macos arm64 dmg
		~(?i)^/dl/kitchen\.apk$ ttpos_kitchen android arm64 apk
		~(?i)^/dl/kitchen\.exe$ ttpos_kitchen windows amd64 exe
		~(?i)^/dl/kitchen\.dmg$ ttpos_kitchen macos arm64 dmg
		~(?i)^/dl/shop\.apk$ ttpos_shop android arm64 apk
		~(?i)^/dl/shop\.exe$ ttpos_shop windows amd64 exe
		~(?i)^/dl/shop\.dmg$ ttpos_shop macos arm64 dmg
		default "" "" "" ""
	}

	@known_short_latest `{short_latest_app} != ""`

	route {
		# MCP server（Streamable HTTP）挂在 /mcp 路径下，复用 API 域名、不另起子域名。
		# handle 保留路径，容器收到 /mcp；flush_interval -1 适配 SSE 流式响应。
		handle /mcp* {
			reverse_proxy faynosync-mcp:3010 {
				flush_interval -1
			}
		}

		handle /dl/* {
			header {
				Cloudflare-CDN-Cache-Control "no-store"
				Cache-Control "no-store"
				match status 4xx 5xx
			}

			handle @known_short_latest {
				# resolve=artifact-latest：短链选「含该 platform/arch/package 制品的最新 published 版本」，
				# 部分平台发版不再 404 未发平台（回退到上一个有制品的版本）。
				rewrite * /apps/latest?owner=ttpos&app_name={short_latest_app}&channel=prod&platform={short_latest_platform}&arch={short_latest_arch}&package={short_latest_package}&resolve=artifact-latest
				header {
					Cloudflare-CDN-Cache-Control "public, max-age=300"
					Cache-Control "no-cache"
					match status 3xx
				}
				reverse_proxy faynosync-api:9000
			}

			respond "unsupported short latest download target" 400
		}

		# 其余路径仍反代到 FaynoSync API。
		handle {
			reverse_proxy faynosync-api:9000
		}
	}
}
