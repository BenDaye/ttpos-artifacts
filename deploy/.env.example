# =============================================================================
# FaynoSync 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# =============================================================================

PORT=9000
ALLOWED_CORS=http://localhost:3000
API_URL=http://localhost:9000
MONGODB_URL=mongodb://root:changeme@db:27017/faynosync?authSource=admin
API_KEY=
MONGODB_URL_TESTS=mongodb://root:changeme@db:27017/faynosync_tests?authSource=admin
JWT_SECRET=
# Single-owner deployment: the one owner namespace, which must equal the admin
# username. Required once an admin exists (the api container fails closed at boot
# if it is unset while an admin already exists). First boot only: leave empty,
# create the admin via /signup, then set it and redeploy. Supersedes SEED_OWNER.
DEPLOYMENT_OWNER=
ENABLE_PRIVATE_APP_DOWNLOADING=false
ENABLE_TELEMETRY=false

# =============================================================================
# MINIO (local or cloud S3-compatible storage)
# =============================================================================
STORAGE_DRIVER=minio
MINIO_SECURE=false
S3_BUCKET_NAME_PRIVATE=faynosync-private
S3_ENDPOINT_PRIVATE=s3:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=faynosync-public
S3_ENDPOINT=s3:9000

# =============================================================================
# AWS S3 (Amazon Simple Storage Service)
# =============================================================================
#STORAGE_DRIVER=aws
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_REGION=
#S3_BUCKET_NAME_PRIVATE=
#S3_BUCKET_NAME=
#S3_ENDPOINT_PRIVATE=https://<bucket_name>.s3.amazonaws.com
#S3_ENDPOINT=https://<bucket_name>.s3.amazonaws.com

# =============================================================================
# DIGITALOCEAN SPACES (S3-compatible storage from DigitalOcean)
# =============================================================================
#STORAGE_DRIVER=digitalocean
#S3_ENDPOINT_PRIVATE=nyc3.digitaloceanspaces.com
#S3_REGION=nyc3
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_BUCKET_NAME_PRIVATE=
#S3_BUCKET_NAME=

# =============================================================================
# GOOGLE CLOUD STORAGE (GCP)
# =============================================================================
#STORAGE_DRIVER=gcp
#GCS_CREDENTIALS_FILE=/path/to/credentials.json
#GCS_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
#GCS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n
#S3_BUCKET_NAME_PRIVATE=
#S3_BUCKET_NAME=

################### Performance Configuration ###################
PERFORMANCE_MODE=true
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

################### Slack Configuration ###################
SLACK_ENABLE=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

################### TUF Configuration ###################
TUF_ENABLED=false
ONLINE_KEY_DIR=/private_keys

# =============================================================================
# 自助测试构建触发（PLAN-040 Track 1）
# 不配即禁用:/build/trigger 返回明确错误,不影响其它功能。
# 凭据只走 env:绝不入库、绝不进日志、绝不提交进仓库(本文件仅占位)。
# =============================================================================
# 触发凭据(二选一)。方式 A(最简):fine-grained PAT,仅需 repo 的 Actions: Read and write。
GITHUB_PAT=
# 方式 B:GitHub App(短时轮换 token,长期更稳)。三件套齐全才生效。
#GITHUB_APP_ID=
#GITHUB_APP_INSTALLATION_ID=
#GITHUB_APP_PRIVATE_KEY=
# 目标仓库(承载 auto-build.yaml)。
GITHUB_REPO_OWNER=BenDaye
GITHUB_REPO_NAME=ttpos-artifacts
# 以下均有默认,可不填。
#BUILD_WORKFLOW_FILE=auto-build.yaml
#BUILD_BASE_URL_TEST=https://api.ttpos.dev/api/v1
#BUILD_BASE_WS_URL_TEST=wss://api.ttpos.dev/ws
# Flutter package → FaynoSync app 名映射(JSON)。键集必须与 dashboard PACKAGE_OPTIONS 一致(6 个,不含 web 端与 android-only 的 qds)。
BUILD_PACKAGE_APP_MAP={"pos":"TTPOS","assistant":"TTPOS Go","kds":"TTPOS Kitchen","tablet":"TTPOS Menu","shop":"TTPOS Shop","kiosk":"TTPOS Kiosk"}
# 成本护栏(默认 12 / 300s / 20)。
#BUILD_MAX_LEGS=12
#BUILD_USER_INTERVAL_SECONDS=300
#BUILD_GLOBAL_PER_HOUR=20

# =============================================================================
# Docker Compose 专用（非 FaynoSync 原生变量）
# =============================================================================
MONGO_USERNAME=root
MONGO_PASSWORD=changeme
API_PORT=9000
DASHBOARD_PORT=3000
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
VITE_ALLOWED_HOSTS=localhost

# =============================================================================
# MCP Server (faynosync-mcp, Streamable HTTP)
# =============================================================================
# 客户端必须携带的 bearer（Authorization: Bearer <值>）。http 模式必填，高熵随机串。
MCP_HTTP_AUTH_TOKEN=
# MCP server 调用 FaynoSync API 用的 fns_ token（由 /token/create 生成）。仅 mcp 服务读取。
API_TOKEN=
# 反代域名白名单（Host 校验）；挂在 update.ttpos.dev/mcp 路径下，故为 API 域名。多个用逗号分隔。
MCP_ALLOWED_HOSTS=update.ttpos.dev
# 允许的浏览器 Origin（默认空＝拒绝一切带 Origin 的请求，挡 DNS-rebinding）。
MCP_ALLOWED_ORIGINS=
# 可选：覆盖 MCP→API 的内网地址（默认 http://api:9000）。
MCP_API_BASE_URL=http://api:9000
