{
  "name": "ttpos-dashboard-next",
  "type": "module",
  "version": "0.2.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --filter @ttpos/web dev",
    "build": "bun --filter @ttpos/web build",
    "preview": "bun --filter @ttpos/web preview",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "version:patch": "bun run scripts/bump-version.ts patch",
    "version:minor": "bun run scripts/bump-version.ts minor",
    "version:major": "bun run scripts/bump-version.ts major"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript": "^6.0.0"
  }
}
