# Base URL of the release registry REST API (required), e.g. https://registry.example.com
API_BASE_URL=

# Option A: a pre-issued bearer token (JWT). Takes precedence when set.
API_TOKEN=

# Option B: username + password. The server logs in once, caches the JWT,
# and refreshes automatically on 401. Ignored when API_TOKEN is set.
API_USERNAME=
API_PASSWORD=

# Optional request timeout in milliseconds (default 15000)
API_TIMEOUT_MS=
